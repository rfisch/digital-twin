<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jacq.wake</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/Code/jacq/digital-twin/.venv/bin/python</string>
        <string>/Volumes/Code/jacq/digital-twin/scripts/wake_service.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/Code/jacq/digital-twin</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
