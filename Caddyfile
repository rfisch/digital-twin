{
	local_certs
}

# Wake server — always available
:9443 {
	tls internal {
		on_demand
	}
	reverse_proxy localhost:9090
}

# App — only responds when the service is started via wake server
:443 {
	tls internal {
		on_demand
	}
	handle /api/* {
		reverse_proxy localhost:8000
	}
	handle {
		reverse_proxy localhost:7860
	}
}
